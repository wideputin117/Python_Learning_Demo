# Copy to .env and fill in. Never commit .env.
APP_NAME=TriageDesk
ENVIRONMENT=development
DEBUG=true

# M2+: database (SQLite file for now, Postgres later)
DATABASE_URL=sqlite+aiosqlite:///./triagedesk.db

# M4+: auth. Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# M6+: AI features. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
